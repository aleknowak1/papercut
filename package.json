{
  "name": "papercut",
  "productName": "PAPERCUT",
  "version": "0.1.0",
  "description": "Turns your own photos into cut-out-animated comedy videos. Working codename; see docs/07-OPEN-QUESTIONS.md OQ-005.",
  "private": true,
  "license": "UNLICENSED",
  "author": {
    "name": "Alek Nowak",
    "email": "alek_nowak@yahoo.com"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:build-scan": "node scripts/check-build-scan.mjs",
    "check:segmentation": "node scripts/check-segmentation.mjs",
    "check:segmentation:hd": "node scripts/check-segmentation.mjs --hd",
    "check:export": "node scripts/check-export.mjs",
    "snapshots:approve": "node scripts/approve-snapshots.mjs",
    "measure:export": "node scripts/check-export.mjs --measure",
    "check": "npm run typecheck && npm run test && npm run check:licenses && npm run check:build-scan && npm run check:segmentation && npm run check:export",
    "fetch-models": "node scripts/fetch-models.mjs",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.papercut.app",
    "productName": "PAPERCUT",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json",
      "node_modules/onnxruntime-node/**"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "birefnet_lite_fp32.onnx",
          "birefnet_full_fp32.onnx"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "mp4-muxer": "^5.2.2",
    "onnxruntime-node": "1.29.0",
    "pixi.js": "8.20.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "mp4box": "^2.4.1",
    "playwright-core": "1.62.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
